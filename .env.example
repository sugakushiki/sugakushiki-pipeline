# Anthropic API key for Claude (used by script_generator, qa_checker, etc.)
# Set this if you call the Claude API directly. If you use the Claude Code CLI
# (claude login), the CLI manages auth on its own and this variable can be left
# at the placeholder.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API key for Gemini (used by image_generator).
# Note: variable name is GOOGLE_API_KEY (not GEMINI_API_KEY) for legacy reasons.
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Text-to-Speech key, for episodes with tts.engine=cloud.
# A SEPARATE key from GOOGLE_API_KEY above -- swapping the two produces errors
# that look like a missing API rather than a wrong credential.
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# YouTube Data API key (reserved for future automated public-status sync).
# Currently unused; uncomment and set when the public-status sync feature ships.
# YOUTUBE_API_KEY=your_youtube_api_key_here
