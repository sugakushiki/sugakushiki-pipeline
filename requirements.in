# requirements.in - top-level direct dependencies
#
# Generated 2026-05-04.
# Edit this file when adding/removing top-level deps. Then regenerate the
# lock file (requirements.txt) by:
#   source venv/Scripts/activate
#   pip install --upgrade -r requirements.in
#   pip freeze > requirements.txt
# (Optionally use pip-tools: `pip-compile requirements.in` produces a comment-
# annotated lock file, but is not required.)
